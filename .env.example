# ── LLM ──────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
LLM_PROVIDER=gemini

# ── Alpaca Market Data ───────────────────────────────
ALPACA_API_KEY=your-alpaca-api-key-here
ALPACA_API_SECRET=your-alpaca-api-secret-here
ALPACA_DATA_URL=https://data.alpaca.markets

# ── Notifications (Primary: NTFY.sh) ────────────────
NTFY_TOPIC=market-intelligence
NTFY_SERVER=https://ntfy.sh

# ── Notifications (Fallback: Home Assistant) ─────────
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your-ha-long-lived-access-token
HA_NOTIFY_SERVICE=notify.mobile_app_iphone

# ── Database ─────────────────────────────────────────
# SQLite path (relative to /app inside Docker)
DB_PATH=data/market_intelligence.db

# ── Cache (Redis) ─────────────────────────────────────
# In Docker Compose the redis service is reachable as redis://redis:6379/0
# For local dev (no Docker) use redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ── Schedule ─────────────────────────────────────────
# 24-hour format, used by the scheduler
SCHEDULE_TIME=19:00

# ── YouTube Summary Pipeline ─────────────────────────
DISCORD_YOUTUBE_WEBHOOK_URL=your-youtube-discord-webhook-url-here

# ── Logging ──────────────────────────────────────────
LOG_LEVEL=INFO
