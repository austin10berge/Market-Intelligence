# ── LLM ──────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── Notifications (Primary: NTFY.sh) ────────────────
NTFY_TOPIC=market-intelligence
NTFY_SERVER=https://ntfy.sh

# ── Notifications (Fallback: Home Assistant) ─────────
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your-ha-long-lived-access-token
HA_NOTIFY_SERVICE=notify.mobile_app_iphone

# ── Database ─────────────────────────────────────────
DB_PATH=data/market_intelligence.db

# ── Schedule ─────────────────────────────────────────
# 24-hour format, used by the scheduler
SCHEDULE_TIME=19:00

# ── Logging ──────────────────────────────────────────
LOG_LEVEL=INFO
