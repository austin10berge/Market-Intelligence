{
  "mcpServers": {
    "alpaca": {
      "command": "alpaca-mcp-server",
      "env": {
        "ALPACA_API_KEY": "${ALPACA_API_KEY}",
        "ALPACA_SECRET_KEY": "${ALPACA_API_SECRET}",
        "ALPACA_PAPER_TRADE": "true",
        "ALPACA_TOOLSETS": "options-data,assets,stock-data"
      },
      "timeout": 30000
    }
  }
}
